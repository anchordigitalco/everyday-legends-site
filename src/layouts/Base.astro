---
// The shell every page shares: head, grain, the fixed nav, and the footer on ink.
// Pages pass their <main> as the default slot. Home adds its intro through the "head" and
// "overlay" slots. `current` is the nav href of the page, which gets aria-current="page".
// Every Donate points to /support; on /support itself, the nav and menu Donate go to its form (#give).
// The two faces, self-hosted as variable woff2 (Fontsource): Fraunces with wght, opsz, SOFT, and WONK;
// Bricolage Grotesque with wght and opsz. Imported before global.css so its tokens name them.
// Fraunces stays on the full file: the opsz-only file has no WONK axis to set to 0, so at opsz 144 it
// draws the wonky ampersand and a different h, m, and n (checked side by side, Phase 8).
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import '../styles/global.css';
import PhoneMenu from '../components/islands/PhoneMenu';
import Button from '../components/Button.astro';
import markUrl from '../../brand_assets/everyday-legends-mark.svg?url';
import logoUrl from '../../brand_assets/everyday-legends-logo.svg?url';
import anchorMarkRaw from '../../brand_assets/anchor-digital-mark.svg?raw';
import { navLinks, supportHref } from '../data/nav';
import { instagramUrl } from '../data/contact';
import { skipLink, newTab } from '../data/a11y';
// Vercel Web Analytics: cookieless page counts, sent only from the Vercel deployment
import Analytics from '@vercel/analytics/astro';

// `noindex` (the 404 page): no canonical link and no og:url, and a robots noindex instead.
type Props = { title: string; description: string; current?: string; noindex?: boolean };
const { title, description, current, noindex = false } = Astro.props;

// The Anchor Digital mark, inline so its currentColor fill takes the footer's paper text on ink.
// The link text names it, so the drawing is decorative here: its title and label come off.
const anchorMark = anchorMarkRaw
  .replace(/<title[^>]*>.*?<\/title>/s, '')
  .replace(/\s(role|aria-labelledby)="[^"]*"/g, '')
  .replace('<svg ', '<svg class="footer__credit-mark" aria-hidden="true" focusable="false" ');

const donateHref = current === supportHref ? '#give' : supportHref;

// Launch basics (CONTEXT.md). The canonical URL is the address the page is served at and linked by: the
// path without a trailing slash (the home page is /), on the site's domain (astro.config.mjs `site`).
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const SITE_NAME = 'Everyday Legends Foundation';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Everyday Legends Foundation logo on a dark ground." />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Her mark: the SVG, a 32px ico for browsers without SVG icons, and the 180px home-screen icon.
         All three come from the same crop (scripts/launch-images.mjs makes the two raster files). -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={markUrl} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
    <!-- The Latin files every page draws first; the other subsets load only if a character needs them -->
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">{skipLink}</a>
    <svg class="sr-defs" aria-hidden="true" focusable="false">
      <filter id="grain" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
    </svg>
    <svg class="page-grain" aria-hidden="true" focusable="false"><rect width="100%" height="100%" filter="url(#grain)" /></svg>

    <slot name="overlay" />

    <header class="nav">
      <a class="nav__mark" href="/" aria-label="Everyday Legends Foundation, home">
        <img src={markUrl} alt="" width="60" height="53" />
      </a>
      <nav aria-label="Main">
        <ul class="nav__links">
          {navLinks.map((l) => (
            <li><a class="nav__link" href={l.href} data-label={l.label} aria-current={l.href === current ? 'page' : undefined}><span>{l.label}</span></a></li>
          ))}
        </ul>
      </nav>
      <Button label="Donate" href={donateHref} class="nav__donate" data-label="Donate" />
      <div class="nav__menu">
        <PhoneMenu client:load links={navLinks} donateHref={donateHref} current={current} />
      </div>
    </header>

    <slot />

    <!-- Footer, on ink so her full gold lockup reads -->
    <footer class="footer">
      <svg class="footer__grain" aria-hidden="true" focusable="false"><rect width="100%" height="100%" filter="url(#grain)" /></svg>
      <div class="grid footer__grid">
        <a class="footer__logo" href="/" aria-label="Everyday Legends Foundation, home">
          <img src={logoUrl} alt="" width="2924" height="2147" loading="lazy" />
        </a>
        <ul class="footer__contact">
          <!-- Breaks only at its middot where the column is too narrow for the whole line (site.ts) -->
          <li><a class="footer__link footer__ig" href={instagramUrl} target="_blank" rel="noopener" data-mid-line><span data-mid-a>Instagram</span><span data-mid>&nbsp;·</span> <span class="footer__handle" data-mid-b>@everydaylegendsfoundation</span><span class="sr-only">{newTab}</span></a></li>
        </ul>
        <div class="footer__base">
          <p class="footer__copy">© 2026 Everyday Legends Foundation, Inc. All rights&nbsp;reserved.</p>
          <ul class="footer__legal">
            <li><a class="footer__link" href="/privacy">Privacy Policy</a></li>
            <li><a class="footer__link footer__credit" href="https://anchordigitalco.com" target="_blank" rel="noopener"><Fragment set:html={anchorMark} /><span>Built by Anchor Digital</span><span class="sr-only">{newTab}</span></a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
