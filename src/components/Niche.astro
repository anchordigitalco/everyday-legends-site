---
// Her arch from everyday-legends-mark.svg (path 1) as a niche: one hairline ink frame, the photo set on
// a concentric inset arch, the standard paper-deep tint over it, and a soft recess under the head.
// The slot holds the photo (an astro:assets <Image>). The frame is .niche in global.css; the photo and
// its sizing live in about.css. `class` adds the placement for each use. `settle` marks the About
// header's photo for its load settle.
// `frame` is the empty niche: the same frame (the .niche rule in global.css) with paper inside and its
// height set by the slot's content instead of the 0.72 ratio. Support's gift form sits in it.
interface Props {
  class?: string;
  settle?: boolean;
  frame?: boolean;
}
const { class: className, settle = false, frame = false } = Astro.props;
---
{frame ? (
  <div class:list={['niche', 'niche--frame', className]}>
    <slot />
  </div>
) : (
  <div class:list={['niche', className]}>
    <div class="niche__photo">
      <div class="niche__plate" data-niche-plate={settle ? '' : undefined}>
        <slot />
        <span class="photo-tint" aria-hidden="true"></span>
      </div>
      <span class="niche__recess" aria-hidden="true"></span>
    </div>
  </div>
)}
