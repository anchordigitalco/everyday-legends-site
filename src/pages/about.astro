---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/about.css';
import markRaw from '../../brand_assets/everyday-legends-mark.svg?raw';
import nichePhoto from '../../brand_assets/Everyday Legends Foundation Luncheon- Yamean Studios Mckee Place Creative Nikon Ambassador-9_websize.jpg';
import podiumPhoto from '../../brand_assets/Everyday Legends Foundation Luncheon- Yamean Studios Mckee Place Creative Nikon Ambassador-48_websize.jpg';

// The torch marker: her torch, isolated from everyday-legends-mark.svg by cropping the viewBox.
// Path 0 is one shape holding the E, the L, and the torch (stem, cup, and the flame's outline), so the
// torch is not a separable group. Rasterising path 0 puts the flame tip at y 1328, the cup at x 2030
// to 2238, and the collar that closes the grip at y 1760 to 1772; the E never reaches past x 2021, and
// below the collar the stem becomes the L. The crop keeps x 2026 to 2242, y 1324 to 1773: flame, cup,
// grip, and collar. Path 7 is the flame's inner tongue. Both are copied verbatim and filled brass by
// CSS; the four low-opacity highlight paths (16, 17, 29, 36) are shading for the gold, left out.
const paths = markRaw.match(/<path\b[^>]*\/>/g) ?? [];
if (paths.length !== 37) throw new Error(`everyday-legends-mark.svg: expected 37 paths, found ${paths.length}`);
const torchPaths = [paths[0], paths[7]].map((p) => p.replace(/\sfill(-opacity)?="[^"]*"/g, '')).join('');
const TORCH_VIEWBOX = '2026 1324 216 449';

// What we do, the three decks and their bodies (everyday-legends-copy.md, 2.5), in copy order.
const pillars = [
  { name: 'Scholarship Support', body: 'Provide financial assistance to students who demonstrate academic excellence, leadership, and perseverance.' },
  { name: 'Athletic Investment', body: 'Support programs that develop discipline, character, and teamwork in young athletes.' },
  { name: 'Community Recognition', body: 'Highlight and fund organizations and culture-shapers who strengthen our communities through service and impact.' },
];

// A plate is as narrow as its deck, so each sentence keeps its last two words together (a non-breaking
// space, the copy itself unchanged) and never ends on one word alone.
const keepLastPair = (text: string) => text.replace(/ (\S+)$/, '\u00a0$1');

// We aim to (2.4): the three lines that complete the label's sentence, stepping down the stair.
const aims = [
  'Provide scholarships that remove financial barriers to opportunity',
  'Support athletic programs that cultivate leadership and character',
  'Honor and support individuals whose impact transforms communities',
];

const QUOTE = 'At the intersection of these forces, legacy is built.';
---
<Base
  title="About the Foundation · Everyday Legends Foundation"
  description="A culture where scholarship, athletics, and service are equally celebrated."
  current="/about"
>
  <Fragment slot="head">
    <script is:inline>
      // Before first paint: with motion allowed, the niche photo starts hidden so it never flashes
      // before it settles (about.ts). Reduced motion leaves it static and visible.
      (function () {
        try {
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('el-settle');
        } catch (e) {}
      })();
    </script>
  </Fragment>

  <main>
    <!-- 1 · Niche header: Our Vision, on paper -->
    <section class="niche-hdr" aria-labelledby="vision-title">
      <div class="grid niche-hdr__grid">
        <div class="niche">
          <div class="niche__photo">
            <div class="niche__plate" data-niche-plate>
              <Image
                src={nichePhoto}
                widths={[400, 640, 900, 1066]}
                sizes="(min-width: 900px) 460px, 90vw"
                alt="Jaylen McClain and his brother at the Legends Among Us luncheon."
                loading="eager"
                fetchpriority="high"
                data-niche-img
              />
              <span class="photo-tint" aria-hidden="true"></span>
            </div>
            <span class="niche__recess" aria-hidden="true"></span>
          </div>
        </div>
        <h1 id="vision-title" class="display niche-hdr__title">Our Vision</h1>
        <p class="niche-hdr__lede">A culture where scholarship, athletics, and service are equally celebrated.</p>
        <p class="niche-hdr__body">Where young people are empowered to lead with integrity, excellence, and purpose, and where communities rally around those who shape the future.</p>
      </div>
    </section>

    <!-- 2 · Our Story, then the page's one pull quote as a full-width inscription -->
    <section class="story" aria-labelledby="story-title">
      <div class="grid story__grid">
        <h2 id="story-title" class="display about-title story__title">Our Story</h2>
        <div class="story__body">
          <p>Everyday Legends was created to honor the pillars that shape identity and purpose: sports, scholarship, and community.</p>
          <p>Athletics provides a safe space where discipline, resilience, and character are developed. Education remains the foundation for opportunity, critical thinking, and long-term advancement. Community and leadership ensure that impact extends beyond individual success, shaping culture and creating lasting change.</p>
        </div>
      </div>
      <div class="inscription">
        <svg class="inscription__grain" aria-hidden="true" focusable="false"><rect width="100%" height="100%" filter="url(#grain)" /></svg>
        <p class="grid inscription__grid">
          <!-- Read once, whole: the visible text is split into lines for the reveal, so it is hidden
               from screen readers and this copy speaks for it. -->
          <span class="sr-only">{QUOTE}</span>
          <span class="display inscription__text" aria-hidden="true" data-inscription>{QUOTE}</span>
        </p>
      </div>
    </section>

    <!-- 3 · Founders' Story & Inspiration: the torch line (scroll-driven moment 2) -->
    <section class="founders" aria-labelledby="founders-title" data-founders>
      <div class="grid founders__grid">
        <div class="founders__side">
          <h2 id="founders-title" class="display founders__title">Founders' Story&nbsp;&amp;&nbsp;Inspiration</h2>
          <p class="label founders__marg" data-placeholder>Founded (to be filled)</p>
        </div>
        <div class="founders__photo">
          <Image
            src={podiumPhoto}
            widths={[600, 900, 1200, 1600]}
            sizes="(min-width: 900px) 50vw, 100vw"
            alt="Dr. Syreeta McClain speaking at the podium at the Legends Among Us luncheon as Jaylen McClain looks on."
            loading="lazy"
            data-founders-img
          />
          <span class="photo-tint" aria-hidden="true"></span>
        </div>
        <div class="founders__line" aria-hidden="true" data-torch-line>
          <span class="founders__track"></span>
          <span class="founders__fill" data-torch-fill></span>
        </div>
        <div class="founders__copy">
          <p>The mission of Everyday Legends is deeply personal. The three pillars of scholarship, community, and sports are the very foundation of the McClain household, where time, energy, sacrifice, and purpose have been intentionally invested for years. These values shaped the upbringing of our family and continue to guide the next generation.</p>
          <p class="founders__torch-p">
            <span class="torch" aria-hidden="true" data-torch-marker>
              <svg class="torch__svg" viewBox={TORCH_VIEWBOX} focusable="false" set:html={torchPaths} />
            </span>Today, the torch is being passed to our three sons, who carry forward the importance of leadership, discipline, service, and giving back.</p>
          <p>Jaylen McClain, Co-Founder of Everyday Legends, uses his athletic platform as a force for good, reinforcing to young people that success is not only measured by personal accomplishments but by how you uplift others. Jaylen demonstrates that athletic achievement and community responsibility can coexist. He, with his brothers coming behind him, represents the vision of using his platform and success responsibly. Everyday Legends exists to ensure that this spirit of service continues for years to come.</p>
        </div>
      </div>
    </section>

    <!-- 4 · We aim to: three lines stepping down and right, a stair of stone -->
    <section class="aim" aria-labelledby="aim-title" data-stair>
      <div class="grid aim__grid">
        <h2 id="aim-title" class="label aim__label">We aim to</h2>
        <ol class="aim__steps">
          {aims.map((line, i) => (
            <li class="aim__step" data-step>
              <span class="aim__rule" aria-hidden="true" data-step-rule></span>
              <span class="aim__line" data-step-line>{line}</span>
              {i === aims.length - 1 && <span class="aim__rule aim__rule--base" aria-hidden="true" data-step-base></span>}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5 · What we do: three plates hung from a brass rail -->
    <section class="what" aria-labelledby="what-title">
      <div class="grid what__grid">
        <h2 id="what-title" class="display about-title what__title">What we do</h2>
        <div class="what__hang hang" data-pillars>
          <div class="hang__rail" aria-hidden="true"></div>
          <ul class="hang__pillars">
            {pillars.map(({ name, body }) => (
              <li class="pillar">
                <span class="pillar__drop" aria-hidden="true" data-pillar-drop></span>
                <div class="pillar__plaque what__plate" data-pillar-plaque>
                  <h3 class="display pillar__name">{name}</h3>
                  <p class="what__body">{keepLastPair(body)}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { initAbout } from '../scripts/about';
    initAbout();
  </script>
</Base>
