---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Niche from '../components/Niche.astro';
import SettleHead from '../components/SettleHead.astro';
import SupportSlab from '../components/SupportSlab.astro';
import '../styles/community.css';
import { entries } from '../data/community';
import { hrefOf } from '../data/nav';
import { getNews, formatNewsDate } from '../data/news';
import nichePhoto from '../../brand_assets/Everyday_Legends_2026_219_websize.jpg';

// Page order (everyday-legends-copy.md, section 3): the niche header, the entries on the rail, newest
// first, In the News, then the closing Support slab. In the News reads Sanity at build time; with no
// items it renders nothing at all, heading included.
const news = await getNews();

// The last two words of a line travel together (a non-breaking space, the copy itself unchanged), so no
// title, deck half, or body ever ends on one word alone.
const pair = (text: string) => text.replace(/ (\S+)$/, ' $1');
---
<Base
  title="In the Community · Everyday Legends Foundation"
  description="Where the work has gone so far."
  current={hrefOf('In the Community')}
>
  <SettleHead slot="head" />

  <main>
    <!-- 1 · Niche header, on paper: About's composition, niche, title, and lede -->
    <section class="niche-hdr" aria-labelledby="community-title">
      <div class="grid niche-hdr__grid">
        <Niche class="niche-hdr__niche" settle>
          <Image
            src={nichePhoto}
            widths={[400, 640, 900, 1200]}
            sizes="(min-width: 900px) 460px, 90vw"
            alt="Natasha Davis-Gomez holds her Community Trailblazer Award between Dr. Syreeta McClain and Jaylen McClain at the Legends Among Us luncheon."
            loading="eager"
            fetchpriority="high"
            style="--focal: 56% 0"
            data-niche-img
          />
        </Niche>
        <h1 id="community-title" class="display niche-hdr__title community-hdr__title">In the&nbsp;Community</h1>
        <p class="niche-hdr__lede">{pair('Where the work has gone so far.')}</p>
      </div>
    </section>

    <!-- 2 · The entries on a brass double rail, newest first. Every entry is built identically:
         one 2:1 photo beside the rail, then the deck line, title, and body. No dates, no links inside. -->
    <section class="log" aria-label="Entries, newest first">
      <ol class="grid log__list">
        {entries.map((e) => (
          <li class="entry" data-entry>
            <span class="entry__rail" aria-hidden="true" data-entry-rail></span>
            <div class="entry__photo" data-entry-rise>
              <Image
                src={e.photo}
                widths={[600, 900, 1200]}
                sizes="(min-width: 900px) 56vw, 100vw"
                alt={e.alt}
                style={`--focal: ${e.focal}`}
              />
              <span class="photo-tint" aria-hidden="true"></span>
            </div>
            <div class="entry__text" data-entry-rise>
              <p class="label entry__deck" data-mid-line>
                <span data-mid-a>{pair(e.deck[0])}</span><span data-mid>&nbsp;·</span>{' '}
                <span data-mid-b>{pair(e.deck[1])}</span>
              </p>
              <h2 class="display entry__title">{pair(e.title)}</h2>
              <p class="entry__body">{pair(e.body)}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- 3 · In the News, from Sanity, newest first. Text only: every card is built identically, one link
         to the original article on an ink hairline, opening in a new tab. Absent when there are no items. -->
    {news.length > 0 && (
      <section class="news" aria-labelledby="news-title">
        <div class="grid news__grid">
          <h2 id="news-title" class="display section-title">In the&nbsp;News</h2>
          <p class="news__lede">{pair('Coverage of the foundation and its work.')}</p>
          <ol class="news__list">
            {news.map((item) => (
              <li class="news__item" data-news>
                <span class="news__rule" aria-hidden="true" data-news-rule></span>
                <a class="news__card" href={item.url} target="_blank" rel="noopener noreferrer" data-news-card>
                  <p class="label news__meta" data-mid-line>
                    <span data-mid-a>{pair(item.outlet)}</span><span data-mid>&nbsp;·</span>{' '}
                    <span data-mid-b class="news__date"><time datetime={item.date}>{formatNewsDate(item.date)}</time></span>
                  </p>
                  <svg class="news__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg>
                  <h3 class="display news__headline">{pair(item.headline)}</h3>
                  <p class="news__summary">{pair(item.summary)}</p>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- 4 · Closing Support slab: Title, Lede, and Donate only -->
    <SupportSlab brief />
  </main>

  <script>
    import { initCommunity } from '../scripts/community';
    initCommunity();
  </script>
</Base>
