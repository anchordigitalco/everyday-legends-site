---
import { Image } from 'astro:assets';
import '../styles/global.css';
import HomeIntro from '../components/HomeIntro.astro';
import markUrl from '../../brand_assets/everyday-legends-mark.svg?url';
import luncheonPhoto from '../../brand_assets/Everyday_Legends_2026_178_websize.jpg';
import { honorees } from '../data/honorees';

const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'In the Community', href: '/in-the-community' },
  { label: 'Legends Among Us', href: '/legends-among-us' },
  { label: 'Contact', href: '/contact' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Everyday Legends Foundation</title>
    <meta name="description" content="Supporting scholars, athletes, and community leaders who exemplify excellence and impact." />
    <link rel="icon" type="image/svg+xml" href={markUrl} />
    <script is:inline>
      // Decides before first paint whether the intro overlay shows: once per session, never with reduced motion.
      (function () {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('el-intro-seen')) return;
          sessionStorage.setItem('el-intro-seen', '1');
          document.documentElement.classList.add('el-intro', 'el-intro-dark');
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Fraunces:opsz,wght,SOFT,WONK@9..144,100..900,0..100,0..1&display=swap"
    />
  </head>
  <body>
    <svg class="sr-defs" aria-hidden="true" focusable="false">
      <filter id="grain" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
    </svg>
    <svg class="page-grain" aria-hidden="true" focusable="false"><rect width="100%" height="100%" filter="url(#grain)" /></svg>

    <HomeIntro />

    <header class="nav">
      <a class="nav__mark" href="/" aria-label="Everyday Legends Foundation, home">
        <img src={markUrl} alt="" width="60" height="53" />
      </a>
      <nav aria-label="Main">
        <ul class="nav__links">
          {navLinks.map((l) => (
            <li><a class="nav__link" href={l.href} data-label={l.label}><span>{l.label}</span></a></li>
          ))}
        </ul>
      </nav>
      <a class="btn btn--primary nav__donate" href="/support" data-label="Donate"><span>Donate</span></a>
    </header>

    <main>
      <!-- 1 · Hero, on paper -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="grid hero__grid">
          <h1 id="hero-title" class="display hero__title" data-hero-item>Everyday Legends Foundation</h1>
          <p class="hero__lede" data-hero-item>Supporting scholars, athletes, and community leaders who exemplify excellence and impact.</p>
          <div class="hero__ctas" data-hero-item>
            <a class="btn btn--primary" href="/support">Donate</a>
            <a class="btn btn--secondary" href="/about">About the foundation</a>
          </div>
        </div>
      </section>

      <!-- 2 · The hall: names hung from a brass rail -->
      <section class="hall" aria-labelledby="class-heading" data-hall>
        <div class="hall__stage" data-hall-stage>
          <div class="hall__rail" aria-hidden="true"></div>
          <div class="hall__track" data-track>
            <div class="hall__class">
              <h2 id="class-heading" class="label hall__heading">Inaugural class, 2026</h2>
              <span class="hall__drop" aria-hidden="true"></span>
              <p class="display hall__year" aria-hidden="true">2026</p>
            </div>
            <ol class="hall__names">
              {honorees.map((name) => (
                <li class="hall__name">
                  <span class="hall__drop" aria-hidden="true"></span>
                  <span class="display hall__text">{name}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- 5 · Legends Among Us: the invitation, laid on the room -->
      <section class="legends" id="legends" aria-labelledby="legends-title">
        <div class="legends__photo">
          <Image
            src={luncheonPhoto}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 900px) 121vw, 100vw"
            alt="Jaylen McClain presents the Athletic & Community Impact Award to Brick City Lions at the Legends Among Us luncheon, May 30, 2026."
            loading="lazy"
          />
          <div class="legends__shade" aria-hidden="true"></div>
          <div class="legends__tint" aria-hidden="true"></div>
        </div>
        <article class="card" data-card>
          <h2 id="legends-title" class="card__title">Legends Among Us</h2>
          <p class="card__lede">Our signature afternoon of recognition.</p>
          <p class="card__body">The Everyday Legends Luncheon brings together scholars, coaches, business leaders, and community champions to honor those who embody the spirit of legacy and leadership.</p>
          <p class="label card__marg">The Highlawn · West Orange, New Jersey</p>
          <a class="btn btn--primary" href="/legends-among-us">The luncheon</a>
        </article>
      </section>
    </main>

    <script>
      import { initHome } from '../scripts/home';
      initHome();
    </script>
  </body>
</html>
