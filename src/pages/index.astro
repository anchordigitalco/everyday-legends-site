---
import { Image } from 'astro:assets';
import '../styles/global.css';
import HomeIntro from '../components/HomeIntro.astro';
import TextReveal from '../components/islands/TextReveal';
import markUrl from '../../brand_assets/everyday-legends-mark.svg?url';
import luncheonPhoto from '../../brand_assets/Everyday_Legends_2026_178_websize.jpg';
import rahwayPhoto from '../../brand_assets/ELRahwayPAL.webp';
import salvationPhoto from '../../brand_assets/ELSalvationArmy.webp';
import luncheonSpeechPhoto from '../../brand_assets/Everyday Legends Foundation Luncheon- Yamean Studios Mckee Place Creative Nikon Ambassador-137_websize.jpg';
import { honorees } from '../data/honorees';

// Our Mission, the three decks (everyday-legends-copy.md, 1.2), hung on the rail in copy order.
const pillars = ['Scholarship Support', 'Athletic Investment', 'Community Recognition'];

// Legends in Action, copy deck order (1.3). Photos per the CONTEXT.md photo table.
// TODO before launch or any push: swap ELRahwayPAL.webp for the masked file (bank numbers on the check).
const actions = [
  {
    title: 'Support for Youth Basketball League, Rahway PAL',
    body: "Jaylen McClain donated to his youth basketball league, Rahway PAL. He is pictured with the Police Athletic League's Dan Marchica and Darius Singletary. Also pictured, Dr. Syreeta McClain, Executive Director of Everyday Legends.",
    photo: rahwayPhoto,
    alt: "Jaylen McClain, Dr. Syreeta McClain, and the Police Athletic League's Dan Marchica and Darius Singletary with the foundation's donation check to Rahway PAL, under the league's banner.",
  },
  {
    title: 'Salvation Army Toy Donation',
    body: 'Jaylen is pictured with Salvation Army leadership during his toy delivery for the Angel Tree Toy Drive, an initiative dedicated to brightening the holidays for children and families in need.',
    photo: salvationPhoto,
    alt: 'Jaylen McClain with Salvation Army leadership during his toy delivery for the Angel Tree Toy Drive.',
  },
  {
    title: 'Legends Among Us, May 30',
    body: 'The foundation hosted its inaugural Legends Among Us luncheon at The Highlawn in West Orange, New Jersey, honoring three scholars, a Young Legend, a Community Trailblazer, and three athletic programs.',
    photo: luncheonSpeechPhoto,
    alt: 'A speaker addresses the room from the lectern at the Legends Among Us luncheon at The Highlawn, beside the welcome sign.',
  },
];

const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'In the Community', href: '/in-the-community' },
  { label: 'Legends Among Us', href: '/legends-among-us' },
  { label: 'Contact', href: '/contact' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Everyday Legends Foundation</title>
    <meta name="description" content="Supporting scholars, athletes, and community leaders who exemplify excellence and impact." />
    <link rel="icon" type="image/svg+xml" href={markUrl} />
    <script is:inline>
      // Decides before first paint whether the intro overlay shows: once per session, never with reduced motion.
      (function () {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('el-intro-seen')) return;
          sessionStorage.setItem('el-intro-seen', '1');
          document.documentElement.classList.add('el-intro', 'el-intro-dark');
        } catch (e) {}
      })();
    </script>
    <noscript><style>.mission__lede, .mission__lede span { opacity: 1 !important; transform: none !important; }</style></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Fraunces:opsz,wght,SOFT,WONK@9..144,100..900,0..100,0..1&display=swap"
    />
  </head>
  <body>
    <svg class="sr-defs" aria-hidden="true" focusable="false">
      <filter id="grain" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
    </svg>
    <svg class="page-grain" aria-hidden="true" focusable="false"><rect width="100%" height="100%" filter="url(#grain)" /></svg>

    <HomeIntro />

    <header class="nav">
      <a class="nav__mark" href="/" aria-label="Everyday Legends Foundation, home">
        <img src={markUrl} alt="" width="60" height="53" />
      </a>
      <nav aria-label="Main">
        <ul class="nav__links">
          {navLinks.map((l) => (
            <li><a class="nav__link" href={l.href} data-label={l.label}><span>{l.label}</span></a></li>
          ))}
        </ul>
      </nav>
      <a class="btn btn--primary nav__donate" href="/support" data-label="Donate"><span>Donate</span></a>
    </header>

    <main>
      <!-- 1 · Hero, on paper -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="grid hero__grid">
          <h1 id="hero-title" class="display hero__title" data-hero-item>Everyday Legends&nbsp;Foundation</h1>
          <p class="hero__lede" data-hero-item>Supporting scholars, athletes, and community leaders who exemplify excellence and impact.</p>
          <div class="hero__ctas" data-hero-item>
            <a class="btn btn--primary" href="/support">Donate</a>
            <a class="btn btn--secondary" href="/about">About the foundation</a>
          </div>
        </div>
      </section>

      <!-- 2 · The hall: names hung from a brass rail -->
      <section class="hall" aria-labelledby="class-heading" data-hall>
        <div class="hall__stage" data-hall-stage>
          <div class="hall__rail" aria-hidden="true"></div>
          <div class="hall__track" data-track>
            <div class="hall__class">
              <h2 id="class-heading" class="label hall__heading">Inaugural class, 2026</h2>
              <span class="hall__drop" aria-hidden="true"></span>
              <p class="display hall__year" aria-hidden="true">2026</p>
            </div>
            <ol class="hall__names">
              {honorees.map((name) => (
                <li class="hall__name">
                  <span class="hall__drop" aria-hidden="true"></span>
                  <span class="display hall__text">{name}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- 3 · Our Mission: three plaques hung from a brass rail -->
      <section class="mission" aria-labelledby="mission-title">
        <div class="grid mission__grid">
          <h2 id="mission-title" class="display mission__title">Our Mission</h2>
          <TextReveal client:visible className="mission__lede" text="Our work bridges scholarship, sports, and service." />
          <p class="mission__body">Everyday Legends Foundation, Inc. is a nonprofit organization that aims to honor achievement, expand scholarship opportunities, reinvest in athletic programs that develop well-rounded leaders, and support community initiatives that create lasting impact.</p>
          <div class="mission__hang" data-pillars>
            <div class="mission__rail" aria-hidden="true"></div>
            <ul class="mission__pillars">
              {pillars.map((name) => (
                <li class="pillar">
                  <span class="pillar__drop" aria-hidden="true" data-pillar-drop></span>
                  <div class="pillar__plaque" data-pillar-plaque>
                    <h3 class="display pillar__name">{name}</h3>
                  </div>
                </li>
              ))}
            </ul>
          </div>
          <div class="mission__cta">
            <a class="btn btn--secondary" href="/about">About the foundation</a>
          </div>
        </div>
      </section>

      <!-- 4 · Legends in Action: three alternating rows, spotlight on hover -->
      <section class="action" aria-labelledby="action-title">
        <svg class="action__grain" aria-hidden="true" focusable="false"><rect width="100%" height="100%" filter="url(#grain)" /></svg>
        <div class="grid action__head">
          <h2 id="action-title" class="display action__title">Legends in Action</h2>
          <p class="action__deck">Recent work in the community</p>
          <a class="btn btn--primary action__all" href="/in-the-community">See all our work</a>
        </div>
        <ol class="action__rows">
          {actions.map((a, i) => (
            <li class="grid action__row" tabindex="0" aria-labelledby={`action-${i + 1}`} data-action-row>
              <div class="action__photo">
                <Image
                  src={a.photo}
                  widths={i === 2 ? [480, 720, 1066] : [600, 900, 1200]}
                  sizes={i === 2 ? '(min-width: 900px) 30vw, 100vw' : '(min-width: 900px) 52vw, 100vw'}
                  alt={a.alt}
                  loading="lazy"
                />
                <span class="action__shade" aria-hidden="true"></span>
                <span class="action__tint" aria-hidden="true"></span>
              </div>
              <div class="action__text">
                <h3 id={`action-${i + 1}`} class="display action__name">{a.title}</h3>
                <p class="action__body">{a.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- 5 · Legends Among Us: the invitation, laid on the room -->
      <section class="legends" id="legends" aria-labelledby="legends-title">
        <div class="legends__photo">
          <Image
            src={luncheonPhoto}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 900px) 121vw, 100vw"
            alt="Jaylen McClain presents the Athletic & Community Impact Award to Brick City Lions at the Legends Among Us luncheon, May 30, 2026."
            loading="lazy"
          />
          <div class="legends__shade" aria-hidden="true"></div>
          <div class="legends__tint" aria-hidden="true"></div>
        </div>
        <article class="card" data-card>
          <h2 id="legends-title" class="card__title">Legends Among&nbsp;Us</h2>
          <p class="card__lede">Our signature afternoon of&nbsp;recognition.</p>
          <p class="card__body">The Everyday Legends Luncheon brings together scholars, coaches, business leaders, and community champions to honor those who embody the spirit of legacy and&nbsp;leadership.</p>
          <p class="label card__marg">The&nbsp;Highlawn&nbsp;· West&nbsp;Orange,&nbsp;New&nbsp;Jersey</p>
          <a class="btn btn--primary" href="/legends-among-us">The luncheon</a>
        </article>
      </section>
    </main>

    <script>
      import { initHome } from '../scripts/home';
      initHome();
    </script>
  </body>
</html>
